PORT=3001
APP_ENV=development
DB_PATH=./data/nonlegacy.db
JWT_SECRET=nonlegacy_dev_secret_key
JWT_EXPIRES_IN=168h
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./data/models
MAX_UPLOAD_SIZE=52428800
MAX_IMAGE_UPLOAD_SIZE=10485760

# ===== AI 导览 =====
# 密钥只放在本文件或部署平台的 Secret 中；不要写进前端或提交到 Git。
# 百炼（DashScope）Key 通常以 sk- 开头：
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QwenCloud 的 sk-ws- Key 使用区域端点，例如新加坡：
# AI_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
AI_ENABLED=true
AI_API_KEY=
AI_CHAT_MODEL=qwen-plus
AI_VISION_MODEL=qwen-vl-max
AI_EMBEDDING_MODEL=text-embedding-v3
AI_EMBEDDING_DIM=1024
AI_DAILY_TOKEN_BUDGET=2000000
AI_RATE_LIMIT_PER_MIN=10
AI_MAX_HISTORY_TURNS=8
AI_REQUEST_TIMEOUT=60s
# 无 Key 时可设为 true，用内置假模型验证前后端链路；评审演示必须使用真实模型。
AI_MOCK_MODE=false
